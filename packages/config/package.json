{
  "name": "@rocketcast/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, ESLint, Prettier, Tailwind presets and the single brand constants file.",
  "type": "module",
  "exports": {
    "./brand": {
      "types": "./src/brand.ts",
      "default": "./src/brand.ts"
    },
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.js",
    "./tailwind/preset.css": "./tailwind/preset.css",
    "./tsconfig/*": "./tsconfig/*"
  },
  "files": [
    "src",
    "eslint",
    "prettier",
    "tailwind",
    "tsconfig"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3",
    "typescript": ">=5"
  }
}
