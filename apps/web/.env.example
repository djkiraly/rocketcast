# Copy to .env.local for local development. Never commit real values (CLAUDE.md: no secrets in repo).

# Neon Postgres connection string used by Drizzle (packages/db) and the web app's API routes.
# Use the pooled host for serverless, e.g. postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth.js secret used to sign/encrypt session cookies and tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-base64-string

# Canonical URL Auth.js uses for callbacks (set to the deployed origin in production).
AUTH_URL=http://localhost:3000

# Public origin of this app, exposed to the browser (public pages, share links, absolute URLs in metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
