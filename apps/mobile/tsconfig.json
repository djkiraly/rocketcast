{
  "extends": "../../packages/config/tsconfig/react-native.json",
  "compilerOptions": {
    // Expo-specific additions on top of the shared react-native preset (which already sets
    // jsx: react-jsx, allowJs, noEmit). Mirrors expo/tsconfig.base without extending it.
    "customConditions": ["react-native"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  // expo-env.d.ts is generated by Expo CLI (gitignored); the pattern is harmless when absent.
  "include": [
    "App.tsx",
    "index.ts",
    "app.config.ts",
    "vitest.config.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", ".expo", "ios", "android", "babel.config.js", "metro.config.js"]
}
