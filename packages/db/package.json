{
  "name": "@rocketcast/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema, migrations, and Neon Postgres client factory.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "files": [
    "src",
    "drizzle"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@rocketcast/config": "workspace:*",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
