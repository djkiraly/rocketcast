# Copy to .env (gitignored). Only EXPO_PUBLIC_* variables are inlined into the app bundle,
# so never put secrets behind that prefix.

# Base URL of the RocketCast web API (apps/web). Local dev: the machine running
# `pnpm --filter @rocketcast/web dev`, reachable from the simulator/emulator
# (the Android emulator reaches the host's localhost at 10.0.2.2).
EXPO_PUBLIC_API_URL=http://localhost:3000
